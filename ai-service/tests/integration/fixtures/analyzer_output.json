              "return_type": "float",
              "docstring": "Total price of the cart including VAT.",
              "source": "    def total(self, cart_id: int) -> float:\n        \"\"\"Total price of the cart including VAT.\"\"\"\n        cart = self.carts.get(cart_id, Cart())\n        return sum(self.prices[p] * q for p, q in cart.items.items())",
