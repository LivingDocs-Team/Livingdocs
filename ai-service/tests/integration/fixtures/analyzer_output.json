              "return_type": "Cart",
              "docstring": "Add a product to the cart, creating the cart if needed.",
              "source": "    def add_item(self, cart_id: int, product_id: int, quantity: int = 1) -> Cart:\n        \"\"\"Add a product to the cart, creating the cart if needed.\"\"\"\n        if quantity <= 0:\n            raise ValueError(\"quantity must be positive\")\n        cart = self.carts.setdefault(cart_id, Cart())\n        cart.items[product_id] = cart.items.get(product_id, 0) + quantity\n        return cart",
