# GitHub OAuth App used by the LivingDocs "Continue with GitHub" sign-in flow.
# Register http://localhost:3000/login/oauth2/code/github as its callback URL.
# These are separate from GITHUB_CLIENT_ID/GITHUB_CLIENT_SECRET below.
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_ID=
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GITHUB_CLIENT_SECRET=

# GitHub App credentials used by the Repository Management connection flow.
# Register http://localhost:8082/api/github/callback as its callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=livingdocs-dev-hai
GITHUB_REDIRECT_URI=http://localhost:8082/api/github/callback

# Required service-to-service and token encryption secrets. Fill these locally;
# do not commit a populated .env file.
GITHUB_INTEGRATION_INTERNAL_SECRET=
TOKEN_ENCRYPTION_KEY=

FRONTEND_URL=http://localhost:3000
