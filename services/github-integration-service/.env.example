# Copy file này thành ".env" rồi điền giá trị thật. KHÔNG commit file .env
GITHUB_CLIENT_ID=Iv23li...
GITHUB_CLIENT_SECRET=dien-client-secret-vao-day
GITHUB_APP_SLUG=livingdocs-dev-hai
GITHUB_REDIRECT_URI=http://localhost:8082/api/github/callback
# Chuoi bi mat dung chung voi Backend (giong GITHUB_INTEGRATION_INTERNAL_SECRET trong file .env goc)
GITHUB_INTEGRATION_INTERNAL_SECRET=
# 32 byte Base64 - xem README muc "Tao khoa ma hoa"
TOKEN_ENCRYPTION_KEY=
# (Tuy chon) Ket noi GitHub xong thi chuyen ve trang nay cua frontend. Bo trong = tra JSON
FRONTEND_URL=
# (Tuy chon) Dia chi frontend duoc goi API, cach nhau boi dau phay
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
